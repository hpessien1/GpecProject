{
  "name": "gpec-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "check:contrast": "playwright test --project=contrast",
    "test": "playwright test --project=desktop --project=phone",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write --ignore-path ../.prettierignore \"src/styles/*.css\"",
    "format:check": "prettier --check --ignore-path ../.prettierignore \"src/styles/*.css\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.10.3",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  }
}
