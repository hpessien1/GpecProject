# Checked at startup by src/config.ts; the server exits with a clear message if a value is invalid.

# development (default), test, or production. Production must set this: it enables the "gpec"
# database guard, the stricter form rate limit, and trust of Coolify's proxy.
NODE_ENV=development
PORT=5001
# Local development uses the gpec_dev database; production (Coolify) uses gpec.
MONGODB_URI=mongodb://127.0.0.1:27017/gpec_dev
# Comma-separated list of exact origins allowed to call the API. Must be https in production.
CLIENT_ORIGIN=http://localhost:5173
# ISO 4217 currency for product prices (e.g. NGN). Leave unset until GPEC confirms the currency:
# while unset, admins cannot edit prices and no payment can start.
# CURRENCY=NGN
# The public website's address, e.g. https://www.example.com (https in production). Used for links
# in emails, and as the Paystack return address.
# FRONTEND_URL=http://localhost:5173

# Email notifications through Amazon SES. Leave all unset to keep email off (nothing is sent; the
# site works normally). Set all five to turn it on; a partial setup stops the server at startup.
# Setup steps: docs/RUNBOOK.md, "Email (Amazon SES)". Never commit real keys.
# SES_REGION=eu-west-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# EMAIL_FROM=GPEC <notifications@example.com>
# STAFF_NOTIFICATION_EMAILS=staff1@example.com,staff2@example.com

# Product photo uploads to a private Amazon S3 bucket. Leave all unset to keep uploads off (admins
# pick images already on the site). Set all four to turn them on; a partial setup stops the server.
# Setup steps: docs/RUNBOOK.md, "Product photos (Amazon S3)". Never commit real keys.
# S3_REGION=eu-west-1
# S3_BUCKET=gpec-product-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Online payment through Paystack's hosted page. Leave all unset to keep payments off (checkout says
# online payment is not available yet). Set all five, plus CURRENCY and FRONTEND_URL, to turn them
# on; a partial setup stops the server. Use test keys (sk_test_…) until GPEC approves live ones.
# The fee settings come from GPEC's own Paystack plan (dashboard), in the smallest currency unit
# (kobo): Paystack's published local rate is 1.5% + ₦100 (waived under ₦2,500), capped at ₦2,000.
# Setup steps: docs/RUNBOOK.md, "Payments (Paystack)". Never commit real keys.
# PAYSTACK_SECRET_KEY=sk_test_
# PAYSTACK_FEE_PERCENT=1.5
# PAYSTACK_FEE_FLAT=10000
# PAYSTACK_FEE_FLAT_WAIVED_BELOW=250000
# PAYSTACK_FEE_CAP=200000

# Two-step login for admins with an authenticator app. Each admin's app secret is stored encrypted
# with this key. Leave unset to keep the authenticator option off (email codes still work while email
# is on). Make it once with `openssl rand -base64 32`; production and development use different
# keys. Never change or remove it while admins use an authenticator app: their codes stop working
# (they can still log in with a recovery code). Never commit a real key.
# TWO_FACTOR_ENCRYPTION_KEY=
