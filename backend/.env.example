# Checked at startup by src/config.ts; the server exits with a clear message if a value is invalid.

# development (default), test, or production. Production must set this: it enables the "gpec"
# database guard, the stricter form rate limit, and trust of Coolify's proxy.
NODE_ENV=development
PORT=5001
# Local development uses the gpec_dev database; production (Coolify) uses gpec.
MONGODB_URI=mongodb://127.0.0.1:27017/gpec_dev
# Comma-separated list of exact origins allowed to call the API. Must be https in production.
CLIENT_ORIGIN=http://localhost:5173
# ISO 4217 currency for product prices (e.g. NGN). Leave unset until GPEC confirms the currency:
# while unset, admins cannot edit prices and no payment can start.
# CURRENCY=NGN
# The public website's address, e.g. https://www.example.com (https in production). Used for links
# in emails, and later for the Paystack return address.
# FRONTEND_URL=http://localhost:5173

# Email notifications through Amazon SES. Leave all unset to keep email off (nothing is sent; the
# site works normally). Set all five to turn it on; a partial setup stops the server at startup.
# Setup steps: docs/RUNBOOK.md, "Email (Amazon SES)". Never commit real keys.
# SES_REGION=eu-west-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# EMAIL_FROM=GPEC <notifications@example.com>
# STAFF_NOTIFICATION_EMAILS=staff1@example.com,staff2@example.com
